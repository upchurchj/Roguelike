            </div>
            <div class="separator"></div>
            <pre><code id="enemy-code">package com.knightlight.game;

import java.io.Serializable;

public class Enemy extends Character implements Serializable {
    private transient Dungeon dungeon;
    private String name;
    private String id;
    private int goldReward;
    private int experienceReward;
    private boolean isBoss;

    public Enemy(int x, int y, int maxHealth, int attack, Dungeon dungeon, String name, int armor, int dodge, int critChance) {
        super(x, y, maxHealth, attack);
        this.dungeon = dungeon;
        this.name = name;
        this.id = name + "_" + System.nanoTime();
        this.armor = armor;
        this.dodgeChance = dodge;
        this.criticalChance = critChance;
        this.goldReward = 5 + (int)(Math.random() * 10);
        this.experienceReward = 10 + (int)(Math.random() * 20);
        this.isBoss = false;
    }

    public void moveToward(Character target) {
        if (target == null || dungeon == null) {
            return;
        }
        int targetX = target.getX();
        int targetY = target.getY();
        if (x &gt; targetX &amp;&amp; dungeon.isWalkable(x - 1, y)) {
            x--;
        } else if (y &gt; targetY &amp;&amp; dungeon.isWalkable(x, y - 1)) {
            y--;
        }
    }

    public String getName() {
        return name;
    }

    public String getId() {
        return id;
    }

    public int getGoldReward() {
        return goldReward;
    }

    public int getExperienceReward() {
        return experienceReward;
    }

    public boolean isDefeated() {
        return !isAlive();
    }

    public boolean isDead() {
        return !isAlive();
    }

    public boolean isBoss() {
        return isBoss;
    }

    public void setBoss(boolean boss) {
        this.isBoss = boss;
    }
}</code></pre>
        </div>

        <div class="file-section" id="equipment">
            <div class="file-header">
                <h2>Equipment.java</h2>
                <span class="file-meta">127 lines | 3571B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('equipment-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="equipment-code">package com.knightlight.game;

import java.io.Serializable;

/**
 * Immutable Equipment item with rarity, stats, and type classification.
 * Uses Builder pattern for safe, flexible construction.
 */
public class Equipment implements Serializable {
    private static final long serialVersionUID = 1L;

    public enum Type {
        WEAPON, ARMOR, RING
    }

    public enum Rarity {
        COMMON("#CCCCCC"),           // Light gray
        UNCOMMON("#4CAF50"),         // Green
        RARE("#2196F3"),             // Blue
        LEGENDARY("#FFD700");        // Gold

        private final String hexColor;

        Rarity(String hexColor) {
            this.hexColor = hexColor;
        }

        public String getHexColor() {
            return hexColor;
        }
    }

    private final String name;
    private final Type type;
    private final Rarity rarity;
    private int floorFound;
    private final int attackBonus;
    private final int defenseBonus;
    private final int hpBonus;
    private final String description;

    /**
     * Private constructor. Use Builder to instantiate.
     */
    private Equipment(Builder builder) {
        this.name = builder.name;
        this.type = builder.type;
        this.rarity = builder.rarity;
        this.attackBonus = builder.attackBonus;
        this.defenseBonus = builder.defenseBonus;
        this.hpBonus = builder.hpBonus;
        this.description = builder.description;
    }

    // Getters
    public String getName() { return name; }
    public Type getType() { return type; }
    public int getFloorFound() { return floorFound; }

    public Rarity getRarity() { return rarity; }
    public int getAttackBonus() { return attackBonus; }
    public int getDefenseBonus() { return defenseBonus; }
    public int getHpBonus() { return hpBonus; }
    public String getDescription() { return description; }

    @Override
    public String toString() {
        return String.format("[%s] %s (%s) | ATK+%d DEF+%d HP+%d",
                rarity, name, type, attackBonus, defenseBonus, hpBonus);
    }

    /**
     * Builder class for Equipment construction.
     */
    public static class Builder {
        private final String name;
        private final Type type;
        private Rarity rarity = Rarity.COMMON;
    private int floorFound;
        private int attackBonus = 0;
        private int defenseBonus = 0;
        private int hpBonus = 0;
        private String description = "";

        public Builder(String name, Type type) {
            this.name = name;
            this.type = type;
        }

        public Builder rarity(Rarity rarity) {
            this.rarity = rarity;
            return this;
        }

        public Builder attackBonus(int bonus) {
            this.attackBonus = bonus;
            return this;
        }

        public Builder defenseBonus(int bonus) {
            this.defenseBonus = bonus;
            return this;
        }

        public Builder hpBonus(int bonus) {
            this.hpBonus = bonus;
            return this;
        }

        public Builder description(String desc) {
            this.description = desc;
            return this;
        }

        public Equipment build() {
            if (name == null || name.isEmpty()) {
                throw new IllegalArgumentException("Equipment name cannot be null or empty");
            }
            if (type == null) {
                throw new IllegalArgumentException("Equipment type cannot be null");
            }
            return new Equipment(this);
        }
    }
}</code></pre>
        </div>

        <div class="file-section" id="experiencesystem">
            <div class="file-header">
                <h2>ExperienceSystem.java</h2>
                <span class="file-meta">116 lines | 3695B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('experiencesystem-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="experiencesystem-code">package com.knightlight.game;

import android.util.Log;
import java.io.Serializable;

public class ExperienceSystem implements Serializable {
    private static final long serialVersionUID = 1L;
    private static final String TAG = "ExperienceSystem";
    private int currentLevel;
    private long currentExperience;
    private long experienceForNextLevel;
    private final Object levelLock = new Object();

    // Experience thresholds using exponential scaling: baseExp * (1.5 ^ (level - 1))
    private static final long BASE_EXPERIENCE = 100L;
    private static final double EXP_MULTIPLIER = 1.5;

    // Stat growth per level
    private static final int HEALTH_PER_LEVEL = 5;
    private static final int ATTACK_PER_LEVEL = 2;
    private static final int DEFENSE_PER_LEVEL = 1;

    public ExperienceSystem() {
        this.currentLevel = 1;
        this.currentExperience = 0;
        this.experienceForNextLevel = calculateExperienceThreshold(1);
        Log.d(TAG, "ExperienceSystem initialized");
    }

    /**
     * Calculates experience needed for a given level
     * @param level Target level (1-based)
     * @return Experience points required
     */
    private static long calculateExperienceThreshold(int level) {
        if (level &lt; 1) {
            Log.w(TAG, "Invalid level requested: " + level);
            return 0L;
        }
        // Exponential scaling: 100 * 1.5^(level-1)
        return Math.round(BASE_EXPERIENCE * Math.pow(EXP_MULTIPLIER, level - 1));
    }

    /**
     * Add experience and check for level-up
     * FIX #9: Restore truncated addExperience() level-up loop
     * @param amount Experience to add (validated to be non-negative)
     * @return Number of levels gained (0 if no level-up)
     */
    public synchronized int addExperience(int amount) {
        if (amount &lt; 0) {
            Log.w(TAG, "Negative experience amount ignored: " + amount);
            return 0;
        }

        currentExperience += amount;
        int levelsGained = 0;

        // Level-up loop: keep leveling while experience exceeds threshold
        while (currentExperience &gt;= experienceForNextLevel) {
            currentExperience -= experienceForNextLevel;
            currentLevel++;
            experienceForNextLevel = calculateExperienceThreshold(currentLevel);
            levelsGained++;
            Log.d(TAG, "Level up! New level: " + currentLevel);
        }

        Log.d(TAG, "Added " + amount + " experience. Total: " + currentExperience + "/" + experienceForNextLevel);
        return levelsGained;
    }

    public int getCurrentLevel() {
        synchronized (levelLock) {
            return currentLevel;
        }
    }

    public long getCurrentExperience() {
        synchronized (levelLock) {
            return currentExperience;
        }
    }

    public long getExperienceForNextLevel() {
        synchronized (levelLock) {
            return experienceForNextLevel;
        }
    }

    public void setCurrentLevel(int level) {
        synchronized (levelLock) {
            this.currentLevel = level;
            this.experienceForNextLevel = calculateExperienceThreshold(level);
            Log.d(TAG, "Level set to: " + level);
        }
    }

    public void setCurrentExperience(long experience) {
        synchronized (levelLock) {
            this.currentExperience = experience;
            Log.d(TAG, "Experience set to: " + experience);
        }
    }

    public static int getHealthPerLevel() {
        return HEALTH_PER_LEVEL;
    }

    public static int getAttackPerLevel() {
        return ATTACK_PER_LEVEL;
    }

    public static int getDefensePerLevel() {
        return DEFENSE_PER_LEVEL;
    }
}</code></pre>
        </div>

        <div class="file-section" id="game">
            <div class="file-header">
                <h2>Game.java</h2>
                <span class="file-meta">182 lines | 5591B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('game-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="game-code">package com.knightlight.game;

import android.util.Log;
import java.util.ArrayList;
import java.util.List;

public class Game {
    public enum GameState {
        PLAYING, WON, LOST
    }

    private static final int ENEMY_HEALTH = 20;
    private static final int ENEMY_ATTACK_POWER = 5;
    private static final int ENEMY_ARMOR = 2;
    private static final int ENEMY_DODGE = 10;
    private static final int ENEMY_CRIT = 5;
    private static final int BOSS_HEALTH = 100;
    private static final int BOSS_DAMAGE = 15;
    private static final int BOSS_ARMOR = 5;
    private static final int BOSS_UNLOCK_GOLD = 100;
    private static final String BOSS_NAME = "Dragon";

    private Player player;
    private Dungeon dungeon;
    private List&lt;Enemy&gt; enemies;
    private GameState state;
    private int turnCount;
    private Enemy encounteredEnemy;

    public Game() {
        this.dungeon = new Dungeon(50, 50);
        int[] spawnPos = dungeon.findSpawnPosition();
        this.player = new Player(spawnPos[0], spawnPos[1]);
        this.enemies = new ArrayList&lt;&gt;();
        this.state = GameState.PLAYING;
        this.turnCount = 0;
        this.encounteredEnemy = null;
        generateEnemies();
    }

    private void generateEnemies() {
        int enemiesSpawned = 0;
        int maxAttempts = 100;
        int attempts = 0;

        while (enemiesSpawned &lt; 5 &amp;&amp; attempts &lt; maxAttempts) {
            int x = (int)(Math.random() * dungeon.getWidth());
            int y = (int)(Math.random() * dungeon.getHeight());

            if (dungeon.isWalkable(x, y) &amp;&amp; !(x == player.getX() &amp;&amp; y == player.getY())) {
                Enemy enemy = new Enemy(x, y, ENEMY_HEALTH, ENEMY_ATTACK_POWER, dungeon, "Goblin", ENEMY_ARMOR, ENEMY_DODGE, ENEMY_CRIT);
                enemies.add(enemy);
                enemiesSpawned++;
            }
            attempts++;
        }

        // FIX: Added turnCount gate so boss can't be unlocked by gold farming alone
        if (turnCount &gt;= 30 &amp;&amp; player.getGoldCollected() &gt;= BOSS_UNLOCK_GOLD) {
            int bossAttempts = 0;
            while (bossAttempts &lt; 50) {
                int x = (int)(Math.random() * dungeon.getWidth());
                int y = (int)(Math.random() * dungeon.getHeight());

                if (dungeon.isWalkable(x, y) &amp;&amp; !(x == player.getX() &amp;&amp; y == player.getY())) {
                    Enemy boss = new Enemy(x, y, BOSS_HEALTH, BOSS_DAMAGE, dungeon, BOSS_NAME, BOSS_ARMOR, ENEMY_DODGE, ENEMY_CRIT);
                    boss.setBoss(true);
                    enemies.add(boss);
                    break;
                }
                bossAttempts++;
            }
        }
    }

    // Call this after boss unlock conditions might have changed
    public void checkBossSpawn() {
        if (turnCount &gt;= 30 &amp;&amp; player.getGoldCollected() &gt;= BOSS_UNLOCK_GOLD) {
            boolean hasBoss = false;
            for (Enemy e : enemies) {
                if (e != null &amp;&amp; e.isBoss() &amp;&amp; !e.isDead()) {
                    hasBoss = true;
                    break;
                }
            }
            if (!hasBoss) {
                generateBoss();
            }
        }
    }

    private void generateBoss() {
        int bossAttempts = 0;
        while (bossAttempts &lt; 50) {
            int x = (int)(Math.random() * dungeon.getWidth());
            int y = (int)(Math.random() * dungeon.getHeight());

            if (dungeon.isWalkable(x, y) &amp;&amp; !(x == player.getX() &amp;&amp; y == player.getY())) {
                Enemy boss = new Enemy(x, y, BOSS_HEALTH, BOSS_DAMAGE, dungeon, BOSS_NAME, BOSS_ARMOR, ENEMY_DODGE, ENEMY_CRIT);
                boss.setBoss(true);
                enemies.add(boss);
                break;
            }
            bossAttempts++;
        }
    }

    public boolean playerMove(int dx, int dy) {
        if (player == null || dungeon == null) {
            return false;
        }

        int newX = player.getX() + dx;
        int newY = player.getY() + dy;

        if (!dungeon.isWalkable(newX, newY)) {
            return false;
        }

        player.move(dx, dy);
        turnCount++;

        char tile = dungeon.getTile(newX, newY);
        if (tile == Dungeon.TILE_GOLD) {
            player.addGold(10);
            dungeon.setTile(newX, newY, Dungeon.TILE_FLOOR);
            checkBossSpawn();
        }

        for (Enemy enemy : enemies) {
            if (enemy != null &amp;&amp; !enemy.isDead() &amp;&amp;
                enemy.getX() == newX &amp;&amp; enemy.getY() == newY) {
                encounteredEnemy = enemy;
                return true;
            }
        }

        return false;
    }

    public void resolveEncounter(Enemy enemy, boolean playerWins) {
        if (playerWins) {
            // FIX: Rewards now handled by CombatSystem.endCombat() - don't duplicate
            enemy.takeDamage(9999);
        } else {
            player.takeDamage(enemy.getAttack());
            if (!player.isAlive()) {
                state = GameState.LOST;
            }
        }

        if (enemy.isBoss() &amp;&amp; !enemy.isAlive()) {
            state = GameState.WON;
        }
    }

    public Player getPlayer() {
        return player;
    }

    public Dungeon getDungeon() {
        return dungeon;
    }

    public List&lt;Enemy&gt; getEnemies() {
        return enemies;
    }

    public GameState getState() {
        return state;
    }

    public int getTurnCount() {
        return turnCount;
    }

    public Enemy getAndClearEncounteredEnemy() {
        Enemy temp = encounteredEnemy;
        encounteredEnemy = null;
        return temp;
    }
}</code></pre>
        </div>

