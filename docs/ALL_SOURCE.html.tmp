        <div class="file-section" id="mainactivity">
            <div class="file-header">
                <h2>MainActivity.java</h2>
                <span class="file-meta">262 lines | 9225B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('mainactivity-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="mainactivity-code">package com.knightlight.game;

import android.content.DialogInterface;
import android.content.Intent;
import android.os.Bundle;
import android.util.Log;
import android.view.View;
import androidx.appcompat.app.AlertDialog;
import androidx.appcompat.app.AppCompatActivity;
import java.io.Serializable;
import java.util.List;

/**
 * Main activity for the Roguelike game.
 * Manages game initialization, state restoration, and battle result handling.
 */
public class MainActivity extends AppCompatActivity implements GameView.GameListener {
    private static final String TAG = "MainActivity";
    private static final int BATTLE_REQUEST = 1;
    private static final int DUNGEON_WIDTH = 50;
    private static final int DUNGEON_HEIGHT = 50;
    private static final int INITIAL_ENEMIES = 10;

    private Game game;
    private GameView gameView;
    private SaveGameManager saveGameManager;
    private Dungeon dungeon;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        gameView = findViewById(R.id.game_view);
        if (gameView == null) {
            Log.e(TAG, "GameView not found in layout");
            finish();
            return;
        }

        saveGameManager = new SaveGameManager(getFilesDir().getAbsolutePath());

        game = new Game();
        if (game == null) {
            Log.e(TAG, "Failed to create Game instance");
            finish();
            return;
        }

        ensurePlayerSpawned();

        // Attempt to restore saved game state
        SaveGameManager.SaveGameData saveData = saveGameManager.loadLatestGame();
        if (saveData != null) {
            restoreGameState(saveData);
        }

        dungeon = game.getDungeon();
        gameView.setGame(game);
        gameView.setGameListener(this);
    }

    private void ensurePlayerSpawned() {
        if (game == null) {
            return;
        }

        Player player = game.getPlayer();
        Dungeon gameDungeon = game.getDungeon();

        if (player == null || gameDungeon == null) {
            Log.w(TAG, "Cannot spawn player: player or dungeon is null");
            return;
        }

        int[] spawnPos = gameDungeon.findSpawnPosition();
        if (spawnPos != null &amp;&amp; spawnPos.length &gt;= 2) {
            player.setX(spawnPos[0]);
            player.setY(spawnPos[1]);
            Log.d(TAG, "Player spawned at (" + spawnPos[0] + ", " + spawnPos[1] + ")");
        } else {
            Log.w(TAG, "Could not find valid spawn position");
        }
    }

    private void restoreGameState(SaveGameManager.SaveGameData saveData) {
        if (saveData == null) {
            return;
        }

        if (saveData.playerX &gt;= 0 &amp;&amp; saveData.playerY &gt;= 0) {
            Player gamePlayer = game.getPlayer();
            if (gamePlayer != null) {
                gamePlayer.setX(saveData.playerX);
                gamePlayer.setY(saveData.playerY);
                Log.d(TAG, "Restored player position to (" + saveData.playerX + ", " + saveData.playerY + ")");
            }
        }

        if (saveData.player != null) {
            Player gamePlayer = game.getPlayer();
            if (gamePlayer != null) {
                int newHealth = Math.max(0, Math.min(saveData.player.getCurrentHealth(), 100));
                gamePlayer.setCurrentHealth(newHealth);
                gamePlayer.setExperience(Math.max(0, saveData.player.getExperience()));
                gamePlayer.setGoldCollected(Math.max(0, saveData.player.getGoldCollected()));
                Log.d(TAG, "Restored player stats");
            }
        }

        if (saveData.enemies != null) {
            List&lt;Enemy&gt; currentEnemies = game.getEnemies();
            if (currentEnemies != null) {
                currentEnemies.clear();
                currentEnemies.addAll(saveData.enemies);
                Log.d(TAG, "Restored " + saveData.enemies.size() + " enemies");
            }
        }
    }

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);

        if (requestCode != BATTLE_REQUEST) {
            return;
        }

        if (resultCode != RESULT_OK) {
            Log.w(TAG, "onActivityResult: Battle activity returned non-OK result");
            return;
        }

        if (data == null) {
            Log.w(TAG, "onActivityResult: data is null");
            return;
        }

        try {
            boolean battleWon = data.getBooleanExtra("battleWon", false);

            Serializable playerExtra = data.getSerializableExtra("updatedPlayer");
            if (!(playerExtra instanceof Player)) {
                Log.w(TAG, "onActivityResult: updatedPlayer is not a valid Player instance");
                return;
            }

            Player updatedPlayer = (Player) playerExtra;
            if (updatedPlayer == null) {
                Log.w(TAG, "onActivityResult: updatedPlayer is null");
                return;
            }

            if (game != null) {
                Player gamePlayer = game.getPlayer();
                if (gamePlayer != null) {
                    int newHealth = Math.max(0, Math.min(updatedPlayer.getCurrentHealth(), 100));
                    gamePlayer.setCurrentHealth(newHealth);
                    gamePlayer.setExperience(Math.max(0, updatedPlayer.getExperience()));
                    gamePlayer.setGoldCollected(Math.max(0, updatedPlayer.getGoldCollected()));
                }
            }

            // Mark defeated enemy as dead
            String defeatedEnemyId = data.getStringExtra("enemyId");
            if (defeatedEnemyId != null &amp;&amp; game != null) {
                List&lt;Enemy&gt; currentEnemies = game.getEnemies();
                if (currentEnemies != null) {
                    for (Enemy e : currentEnemies) {
                        if (e != null &amp;&amp; e.getId().equals(defeatedEnemyId)) {
                            if (e.isDefeated()) {
                                currentEnemies.remove(e);
                                Log.d(TAG, "Enemy " + defeatedEnemyId + " removed from active enemies");
                            }
                            break;
                        }
                    }
                }
            }

            if (!battleWon &amp;&amp; game != null) {
                Log.d(TAG, "Battle lost; game state set to LOST");
            }

            if (gameView != null) {
                gameView.invalidate();
            }

        } catch (Exception e) {
            Log.e(TAG, "Error processing battle result", e);
        }
    }

    @Override
    public void onEncounter(Enemy enemy) {
        if (enemy != null &amp;&amp; game != null) {
            Intent battleIntent = new Intent(MainActivity.this, BattleActivity.class);
            battleIntent.putExtra("player", game.getPlayer());
            // FIX: Was "enemy_id" (String) but BattleActivity reads "enemy" (Serializable)
            battleIntent.putExtra("enemy", enemy);
            startActivityForResult(battleIntent, BATTLE_REQUEST);
        }
    }

    @Override
    public void onQuitRequested() {
        new AlertDialog.Builder(this)
                .setTitle("Quit Game")
                .setMessage("Are you sure you want to quit? Your progress will be saved.")
                .setPositiveButton("Quit", new DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(DialogInterface dialog, int which) {
                        saveAndQuit();
                    }
                })
                .setNegativeButton("Cancel", new DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(DialogInterface dialog, int which) {
                        dialog.dismiss();
                    }
                })
                .show();
    }

    @Override
    public void onGameOver(Game.GameState state) {
        Log.d(TAG, "Game over: " + state);
    }

    private void saveAndQuit() {
        if (game != null &amp;&amp; saveGameManager != null) {
            Player player = game.getPlayer();
            List&lt;Enemy&gt; enemies = game.getEnemies();
            Dungeon gameDungeon = game.getDungeon();

            char[][] charGrid = gameDungeon.getGrid();
            int[][] dungeonMap = null;

            if (charGrid != null) {
                dungeonMap = new int[charGrid.length][];
                for (int y = 0; y &lt; charGrid.length; y++) {
                    dungeonMap[y] = new int[charGrid[y].length];
                    for (int x = 0; x &lt; charGrid[y].length; x++) {
                        dungeonMap[y][x] = charGrid[y][x];
                    }
                }
            }

            SaveGameManager.SaveGameData data = new SaveGameManager.SaveGameData();
            data.playerX = player.getX();
            data.playerY = player.getY();
            data.player = player;
            data.enemies = enemies;
            data.dungeonMap = dungeonMap;

            saveGameManager.saveGame(data);
            Log.d(TAG, "Game saved");
        }

        finish();
    }
}</code></pre>
