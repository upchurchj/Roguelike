            <div class="separator"></div>
            <pre><code id="player-code">package com.knightlight.game;

import java.io.Serializable;

public class Player extends Character implements Serializable {
    private static final long serialVersionUID = 1L;

    private int level;
    private int experience;
    private int goldCollected;
    private String name;

    // Constructor with x, y parameters
    public Player(int x, int y) {
        super(x, y, 100, 10);
        this.name = "Hero";
        this.level = 1;
        this.experience = 0;
        this.goldCollected = 0;
    }

    // Constructor for deserialization
    public Player() {
        super(0, 0, 100, 10);
        this.name = "Hero";
        this.level = 1;
        this.experience = 0;
        this.goldCollected = 0;
    }

    // Constructor with name parameter (for compatibility)
    public Player(String name) {
        super(0, 0, 100, 10);
        this.name = name;
        this.level = 1;
        this.experience = 0;
        this.goldCollected = 0;
    }

    // Movement method
    public void move(int dx, int dy) {
        this.x += dx;
        this.y += dy;
    }

    // Gold methods
    public void addGold(int amount) {
        this.goldCollected += amount;
    }

    public int getGoldCollected() {
        return goldCollected;
    }

    public void setGoldCollected(int gold) {
        this.goldCollected = gold;
    }

    // Health methods
    public int getCurrentHealth() {
        return currentHealth;
    }

    public void setCurrentHealth(int health) {
        this.currentHealth = Math.max(0, Math.min(health, maxHealth));
    }

    // Experience and leveling
    public void addExperience(int amount) {
        this.experience += amount;
        checkLevelUp();
    }

    public int getExperience() {
        return experience;
    }

    public void setExperience(int exp) {
        this.experience = exp;
        checkLevelUp();
    }

    public int getLevel() {
        return level;
    }

    // FIXED: Added missing checkLevelUp() method
    private void checkLevelUp() {
        // Typical roguelike formula: 100 * level to level up
        int xpThreshold = 100 * level;

        if (experience &gt;= xpThreshold) {
            // Increase level
            level++;

            // Carry over excess experience
            experience -= xpThreshold;

            // Stat boosts on level up
            int maxHealthIncrease = 20;

            // Update stats from Character parent class
            this.currentHealth += maxHealthIncrease;
            this.maxHealth += maxHealthIncrease;

            // Heal back to full on level up
            setCurrentHealth(maxHealth);
        }
    }

    // Potion usage - returns boolean
    public boolean usePotion() {
        int healAmount = 50;
        if (currentHealth &lt; maxHealth) {
            heal(healAmount);
            return true;
        }
        return false;
    }

    // Name getter
    public String getName() {
        return name;
    }
}</code></pre>
