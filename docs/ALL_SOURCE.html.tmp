            <div class="separator"></div>
            <pre><code id="savegamemanager-code">package com.knightlight.game;

import android.util.Log;
import java.io.*;
import java.util.*;

public class SaveGameManager {
    private static final String TAG = "SaveGameManager";
    private static final String SAVE_DIR = "saves";
    private String basePath;

    public SaveGameManager(String basePath) {
        this.basePath = basePath;
        File saveDir = new File(basePath, SAVE_DIR);
        if (!saveDir.exists()) {
            saveDir.mkdirs();
            Log.d(TAG, "Created save directory: " + saveDir.getAbsolutePath());
        }
    }

    private String validateFilename(String filename) {
        if (filename == null || filename.isEmpty()) {
            throw new IllegalArgumentException("Filename cannot be null or empty");
        }
        String sanitized = filename.replaceAll("[^a-zA-Z0-9._-]", "");
        if (sanitized.isEmpty()) {
            throw new IllegalArgumentException("Filename contains no valid characters");
        }
        if (sanitized.contains("..")) {
            throw new IllegalArgumentException("Filename cannot contain path traversal sequences");
        }
        return sanitized;
    }

    private String getSavePath(String filename) {
        String validated = validateFilename(filename);
        return new File(new File(basePath, SAVE_DIR), validated).getAbsolutePath();
    }

    public void saveGame(SaveGameData data, String filename) {
        if (data == null || data.player == null) {
            Log.w(TAG, "Cannot save: SaveGameData or player is null");
            return;
        }
        if (data.player.getHealth() &lt;= 0) {
            Log.w(TAG, "Cannot save: player is dead");
            return;
        }

        try {
            String savePath = getSavePath(filename);
            FileOutputStream fos = new FileOutputStream(savePath);
            ObjectOutputStream oos = new ObjectOutputStream(fos);
            oos.writeObject(data);
            oos.close();
            fos.close();
            Log.d(TAG, "Game saved to: " + savePath);
        } catch (IOException e) {
            Log.e(TAG, "Error saving game", e);
        } catch (IllegalArgumentException e) {
            Log.e(TAG, "Invalid filename: " + filename, e);
        }
    }

    public void saveGame(SaveGameData data) {
        saveGame(data, "savegame_" + System.currentTimeMillis() + ".sav");
    }

    public SaveGameData loadGame(String filename) {
        try {
            String savePath = getSavePath(filename);
            FileInputStream fis = new FileInputStream(savePath);
            ObjectInputStream ois = new ObjectInputStream(fis);
            SaveGameData data = (SaveGameData) ois.readObject();
            ois.close();
            fis.close();
            Log.d(TAG, "Game loaded from: " + savePath);
            return data;
        } catch (IOException | ClassNotFoundException e) {
            Log.e(TAG, "Error loading game", e);
            return null;
        } catch (IllegalArgumentException e) {
            Log.e(TAG, "Invalid filename: " + filename, e);
            return null;
        }
    }

    public SaveGameData loadLatestGame() {
        try {
            File saveDir = new File(basePath, SAVE_DIR);
            if (!saveDir.exists()) {
                return null;
            }
            File[] saves = saveDir.listFiles();
            if (saves == null || saves.length == 0) {
                return null;
            }
            Arrays.sort(saves, (a, b) -&gt; Long.compare(b.lastModified(), a.lastModified()));
            FileInputStream fis = new FileInputStream(saves[0]);
            ObjectInputStream ois = new ObjectInputStream(fis);
            SaveGameData data = (SaveGameData) ois.readObject();
            ois.close();
            fis.close();
            Log.d(TAG, "Latest game loaded from: " + saves[0].getName());
            return data;
        } catch (IOException | ClassNotFoundException e) {
            Log.e(TAG, "Error loading latest game", e);
            return null;
        }
    }

    public List&lt;String&gt; listSaveFiles() {
        List&lt;String&gt; saveFiles = new ArrayList&lt;&gt;();
        try {
            File saveDir = new File(basePath, SAVE_DIR);
            if (!saveDir.exists()) {
                return saveFiles;
            }
            File[] files = saveDir.listFiles();
            if (files != null) {
                for (File f : files) {
                    if (f.isFile()) {
                        saveFiles.add(f.getName());
                    }
                }
                Collections.sort(saveFiles);
            }
        } catch (Exception e) {
            Log.e(TAG, "Error listing save files", e);
        }
        return saveFiles;
    }

    public boolean deleteSaveFile(String filename) {
        try {
            String savePath = getSavePath(filename);
            File file = new File(savePath);
            if (file.exists() &amp;&amp; file.delete()) {
                Log.d(TAG, "Save file deleted: " + filename);
                return true;
            }
        } catch (IllegalArgumentException e) {
            Log.e(TAG, "Error deleting save file " + filename, e);
        }
        return false;
    }

    public static class SaveGameData implements Serializable {
        private static final long serialVersionUID = 1L;

        public Player player;
        public List&lt;Enemy&gt; enemies;
        public int[][] dungeonMap;
        public int playerX;
        public int playerY;

        public SaveGameData(Player player, List&lt;Enemy&gt; enemies, int[][] dungeonMap, int playerX, int playerY) {
            this.player = player;
            this.enemies = enemies;
            this.dungeonMap = dungeonMap;
            this.playerX = playerX;
            this.playerY = playerY;
        }

        public SaveGameData() {
        }
    }
}</code></pre>
