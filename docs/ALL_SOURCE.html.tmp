                <h2>CombatSystem.java</h2>
                <span class="file-meta">124 lines | 4001B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('combatsystem-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="combatsystem-code">package com.knightlight.game;

import android.util.Log;
import java.util.ArrayList;
import java.util.List;

public class CombatSystem {
    private static final String TAG = "CombatSystem";

    private Player player;
    private Enemy enemy;
    private List&lt;String&gt; combatLog;
    private String lastLogEntry;

    public CombatSystem(Player player, Enemy enemy) {
        this.player = player;
        this.enemy = enemy;
        this.combatLog = new ArrayList&lt;&gt;();
        this.lastLogEntry = "";
        Log.d(TAG, "CombatSystem initialized with player vs " + enemy.getName());
    }

    public String getLastLogEntry() {
        return lastLogEntry;
    }

    public List&lt;String&gt; getCombatLog() {
        return new ArrayList&lt;&gt;(combatLog);
    }

    public void playerAttack() {
        if (player == null || enemy == null) {
            Log.w(TAG, "playerAttack called with null player or enemy");
            return;
        }

        int playerAttack = player.getAttack();
        int enemyDefense = enemy.getArmor();

        // Damage calculation: max(1, attack - defense + random 0-4)
        int damage = Math.max(1, playerAttack - enemyDefense + (int) (Math.random() * 5));

        enemy.takeDamage(damage);
        lastLogEntry = "You attack for " + damage + " damage!";
        combatLog.add(lastLogEntry);
        Log.d(TAG, lastLogEntry);
    }

    public void enemyAttack() {
        if (player == null || enemy == null) {
            Log.w(TAG, "enemyAttack called with null player or enemy");
            return;
        }

        int enemyAttack = enemy.getAttack();
        int playerDefense = player.getArmor();

        // Base damage calculation
        int baseDamage = Math.max(1, enemyAttack - playerDefense);

        // Apply variance (±0-3)
        int variance = (int) (Math.random() * 4) - 1;
        int damage = Math.max(1, baseDamage + variance);

        player.takeDamage(damage);
        lastLogEntry = enemy.getName() + " attacks for " + damage + " damage!";
        combatLog.add(lastLogEntry);
        Log.d(TAG, lastLogEntry);
    }

    public boolean attemptFlee() {
        double fleeChance = 0.3;
        boolean success = Math.random() &lt; fleeChance;
        lastLogEntry = success ? "You escaped!" : "Failed to escape!";
        combatLog.add(lastLogEntry);
        Log.d(TAG, lastLogEntry);
        return success;
    }

    /**
     * Called when combat ends. Handles victory/defeat/ongoing state.
     * Returns CombatResult with outcome and any rewards.
     * FIX: Uses Enemy's configured reward values instead of inflated formula.
     */
    public CombatResult endCombat() {
        // Victory: Enemy defeated
        if (!enemy.isAlive()) {
            // FIX: Was 50 * enemy.getHealth() (1000 XP!) - now uses Enemy's config
            int xpReward = enemy.getExperienceReward();
            int goldReward = enemy.getGoldReward();

            if (xpReward &gt; 0) {
                player.addExperience(xpReward);
                combatLog.add("Gained " + xpReward + " experience!");
            }

            if (goldReward &gt; 0) {
                player.addGold(goldReward);
                combatLog.add("Gained " + goldReward + " gold!");
            }

            Log.d(TAG, "Victory - Player gained " + xpReward + "xp and " + goldReward + "g");
            return CombatResult.victory(player.getName() + " defeated " + enemy.getName() + "!", xpReward, goldReward);
        }

        // Defeat: Player defeated
        if (!player.isAlive()) {
            Log.d(TAG, "Defeat - Player defeated by " + enemy.getName());
            return CombatResult.defeat(player.getName() + " was defeated by " + enemy.getName() + "!");
        }

        // Combat still ongoing (neither party defeated)
        Log.w(TAG, "endCombat called but combat is still ongoing");
        return CombatResult.ongoing();
    }

    public Player getPlayer() {
        return player;
    }

    public Enemy getEnemy() {
        return enemy;
    }
}</code></pre>
