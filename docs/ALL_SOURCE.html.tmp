        <div class="file-section" id="dungeon">
            <div class="file-header">
                <h2>Dungeon.java</h2>
                <span class="file-meta">214 lines | 6070B</span>
                <button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('dungeon-code').innerText)">Copy</button>
            </div>
            <div class="separator"></div>
            <pre><code id="dungeon-code">package com.knightlight.game;

import java.util.ArrayList;
import java.util.List;

public class Dungeon {
    public static final char TILE_WALL = '#';
    public static final char TILE_FLOOR = '.';
    public static final char TILE_GOLD = 'G';

    private char[][] tiles;
    private int width;
    private int height;
    private List&lt;Room&gt; rooms;

    public Dungeon(int width, int height) {
        this.width = width;
        this.height = height;
        this.tiles = new char[height][width];
        this.rooms = new ArrayList&lt;&gt;();

        initializeDungeon();
        generateDungeon();
    }

    private void initializeDungeon() {
        for (int y = 0; y &lt; height; y++) {
            for (int x = 0; x &lt; width; x++) {
                tiles[y][x] = TILE_WALL;
            }
        }
    }

    private void generateDungeon() {
        int roomCount = 5 + (int)(Math.random() * 5);
        for (int i = 0; i &lt; roomCount; i++) {
            int roomWidth = 8 + (int)(Math.random() * 8);
            int roomHeight = 8 + (int)(Math.random() * 8);
            int roomX = (int)(Math.random() * (width - roomWidth));
            int roomY = (int)(Math.random() * (height - roomHeight));

            Room room = new Room(roomX, roomY, roomWidth, roomHeight);
            if (canPlaceRoom(room)) {
                rooms.add(room);
                carveRoom(room);
            }
        }

        connectRooms();
        placeGold();
    }

    private boolean canPlaceRoom(Room room) {
        for (Room existingRoom : rooms) {
            if (room.intersects(existingRoom)) {
                return false;
            }
        }
        return true;
    }

    private void carveRoom(Room room) {
        for (int y = room.y; y &lt; room.y + room.height; y++) {
            for (int x = room.x; x &lt; room.x + room.width; x++) {
                if (x &gt;= 0 &amp;&amp; x &lt; width &amp;&amp; y &gt;= 0 &amp;&amp; y &lt; height) {
                    tiles[y][x] = TILE_FLOOR;
                }
            }
        }
    }

    private void connectRooms() {
        for (int i = 0; i &lt; rooms.size() - 1; i++) {
            Room room1 = rooms.get(i);
            Room room2 = rooms.get(i + 1);

            int x1 = room1.getCenterX();
            int y1 = room1.getCenterY();
            int x2 = room2.getCenterX();
            int y2 = room2.getCenterY();

            if (Math.random() &lt; 0.5) {
                carveCorridor(x1, y1, x2, y1);
                carveCorridor(x2, y1, x2, y2);
            } else {
                carveCorridor(x1, y1, x1, y2);
                carveCorridor(x1, y2, x2, y2);
            }
        }
    }

    private void carveCorridor(int x1, int y1, int x2, int y2) {
        int minX = Math.min(x1, x2);
        int maxX = Math.max(x1, x2);
        int minY = Math.min(y1, y2);
        int maxY = Math.max(y1, y2);

        for (int x = minX; x &lt;= maxX; x++) {
            if (x &gt;= 0 &amp;&amp; x &lt; width &amp;&amp; y1 &gt;= 0 &amp;&amp; y1 &lt; height) {
                tiles[y1][x] = TILE_FLOOR;
            }
        }

        for (int y = minY; y &lt;= maxY; y++) {
            if (x2 &gt;= 0 &amp;&amp; x2 &lt; width &amp;&amp; y &gt;= 0 &amp;&amp; y &lt; height) {
                tiles[y][x2] = TILE_FLOOR;
            }
        }
    }

    private void placeGold() {
        for (Room room : rooms) {
            if (Math.random() &lt; 0.3) {
                int x = room.x + (int)(Math.random() * room.width);
                int y = room.y + (int)(Math.random() * room.height);
                if (isWalkable(x, y)) {
                    tiles[y][x] = TILE_GOLD;
                }
            }
        }
    }

    public boolean isWalkable(int x, int y) {
        if (x &lt; 0 || x &gt;= width || y &lt; 0 || y &gt;= height) {
            return false;
        }
        char tile = tiles[y][x];
        return tile == TILE_FLOOR || tile == TILE_GOLD;
    }

    public char getTile(int x, int y) {
        if (x &lt; 0 || x &gt;= width || y &lt; 0 || y &gt;= height) {
            return TILE_WALL;
        }
        return tiles[y][x];
    }

    public void setTile(int x, int y, char tile) {
        if (x &gt;= 0 &amp;&amp; x &lt; width &amp;&amp; y &gt;= 0 &amp;&amp; y &lt; height) {
            tiles[y][x] = tile;
        }
    }

    public int getWidth() {
        return width;
    }

    public int getHeight() {
        return height;
    }

    public int[] findSpawnPosition() {
        if (rooms.isEmpty()) {
            return new int[]{width / 2, height / 2};
        }

        Room spawnRoom = rooms.get(0);
        carveSpawnArea(spawnRoom);
        int spawnX = spawnRoom.getCenterX();
        int spawnY = spawnRoom.getCenterY();
        if (isWalkable(spawnX, spawnY)) {
            return new int[]{spawnX, spawnY};
        }

        for (int y = spawnRoom.y; y &lt; spawnRoom.y + spawnRoom.height; y++) {
            for (int x = spawnRoom.x; x &lt; spawnRoom.x + spawnRoom.width; x++) {
                if (isWalkable(x, y)) {
                    return new int[]{x, y};
                }
            }
        }

        return new int[]{spawnX, spawnY};
    }

    private void carveSpawnArea(Room room) {
        for (int y = room.y; y &lt; room.y + room.height; y++) {
            for (int x = room.x; x &lt; room.x + room.width; x++) {
                if (x &gt;= 0 &amp;&amp; x &lt; width &amp;&amp; y &gt;= 0 &amp;&amp; y &lt; height) {
                    tiles[y][x] = TILE_FLOOR;
                }
            }
        }
    }

    public char[][] getGrid() {
        return tiles;
    }

    public static class Room {
        public int x, y, width, height;

        public Room(int x, int y, int width, int height) {
            this.x = x;
            this.y = y;
            this.width = width;
            this.height = height;
        }

        public int getCenterX() {
            return x + width / 2;
        }

        public int getCenterY() {
            return y + height / 2;
        }

        public boolean intersects(Room other) {
            int padding = 2;
            return !(x + width + padding &lt; other.x || other.x + other.width + padding &lt; x ||
                     y + height + padding &lt; other.y || other.y + other.height + padding &lt; y);
        }
    }
}</code></pre>
